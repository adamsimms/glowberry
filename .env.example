# Project media folder: a local outbox that a daily job copies to off-site storage, then clears
# 14 days after the copies are verified. Reviewable output (studies, tests) goes to
# <this>/<stage>/<YYYY-MM>-<NAME>/; unset = local fallback (gitignored, not backed up).
MEDIA_DIR=

# Scan working folder (Metashape project, masks, clouds, exports). Holds metashape/ at its root.
# Only reconstruction steps need it; the print pipeline does not. Fetch it from off-site media storage
# when needed and delete it after. Unset = ~/Desktop/BERRY.
BERRY_ROOT=
