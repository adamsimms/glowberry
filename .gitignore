*.py[cod]

# Fabrication dumps, until an issue asks to publish one
*.blend
*.stl
*.obj
*.glb
*.gltf
*.ply
*.psx
/models/*
!/models/provenance/
!/models/provenance/**
!/models/provenance/*.glb
